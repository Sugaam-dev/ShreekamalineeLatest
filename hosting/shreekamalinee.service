[Unit]
Description=Shreekamalinee website and admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shreekamalinee
Group=shreekamalinee
WorkingDirectory=/opt/shreekamalinee/source
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/shreekamalinee/source/scripts/run-next.mjs start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
